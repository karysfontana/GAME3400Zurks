--- !u!114 &198617209
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 198617208}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22da19c42a28a4096b157f7c02c66e98, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - speaker: Caller
    dialogueText: "Hey\u2026 you\u2026-uh thanks for picking up..."
  - speaker: Caller
    dialogueText: "I\u2019m sorry\u2026 I just"
  - speaker: Caller
    dialogueText: "\u2026can\u2019t anymore."
  - speaker: Caller
    dialogueText: "I-I know it\u2019s not a good time to do this-"
  - speaker: Caller
    dialogueText: "Well, there\u2019s never really a good time to do this-but"
  - speaker: Caller
    dialogueText: You know what I mean.
  - speaker: Caller
    dialogueText: "I know-I know that you\u2019re grieving but please just listen to me."
  - speaker: Caller
    dialogueText: "I just\u2026"
  - speaker: Caller
    dialogueText: "I can\u2019t be the one who processes your feelings for you anymore."
  - speaker: Caller
    dialogueText: "No-no just\u2026"
  - speaker: Caller
    dialogueText: Just stop.
  - speaker: Caller
    dialogueText: "You always say that-that you\u2019ll change or be better but\u2026"
  - speaker: Caller
    dialogueText: You never follow through.
  - speaker: Caller
    dialogueText: "I just can\u2019t take another year of this-I-I can\u2019t."
  - speaker: Caller
    dialogueText: "It\u2019s over."
  dialogueStarted: 0
